      value: "\u6240\u6709\u734E\u91D1\u4E58\u4EE5\u57FA\u790E\u6295\u6CE8\u3002\n\u6240\u6709\u91D1\u984D\u5747\u4EE5\u5BE6\u969B\u734E\u91D1\uFF08\u4EE5\u786C\u5E63\u8A08\u7B97\uFF09\u8868\u793A\u3002\n\u4F7F\u7528\u591A\u500B\u7B26\u865F\u7372\u52DD\u6642\uFF0C\u6240\u6709\u734E\u91D1\u5C07\u6DFB\u52A0\u5230\u7E3D\u734E\u91D1\u4E2D\u3002\n\u514D\u8CBB\u65CB\u8F49\u734E\u91D1\u5C07\u5728\u56DE\u5408\u7D50\u675F\u5F8C\u734E\u52F5\u7D66\u73A9\u5BB6\u3002\n\u6B77\u53F2\u8A18\u9304\u4E2D\u7684\u514D\u8CBB\u65CB\u8F49\u7E3D\u734E\u91D1\u5305\u542B\u8A72\u9031\u671F\u7684\u5168\u90E8\u734E\u91D1\u3002"
