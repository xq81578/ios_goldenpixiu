      m_Items: []
  - m_Id: 1529315334361110
    m_Localized: Turbo Spin
    m_Metadata:
      m_Items: []
  - m_Id: 1529315334361111
    m_Localized: Click / tap to enable or disable the Turbo Spin to reduce the duration
      of reel spins in the main game.
    m_Metadata:
      m_Items: []
  - m_Id: 1529315334361112
    m_Localized: Sound
    m_Metadata:
      m_Items: []
