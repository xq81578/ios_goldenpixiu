  - m_Id: 69304683977576450
    m_Localized: "\u904A\u6232\u4E2D\u65B7"
    m_Metadata:
      m_Items: []
  - m_Id: 69304683977576451
    m_Localized: "\u6240\u6709\u904A\u6232\u56DE\u5408\u5747\u53EF\u5728\u6B77\u53F2\u8A18\u9304\u4E2D\u67E5\u770B\u3002\n\u4EFB\u4F55\u672A\u5B8C\u6210\u904A\u6232\u7684\u6295\u6CE8\u91D1\u984D\u90FD\u5C07\u66AB\u505C\uFF0C\u76F4\u5230\u60A8\u5B8C\u6210\u904A\u6232\u6216\u56E0\u5E33\u6236\u9592\u7F6E\u6216\u7CFB\u7D71\u7DAD\u8B77\u5C0E\u81F4\u904A\u6232\u7121\u6548\u70BA\u6B62\u3002\n\u4EFB\u4F55\u672A\u5B8C\u6210\u56DE\u5408\u7372\u5F97\u7684\u734E\u52F5\u5C07\u4E0D\u4E88\u8A18\u5165\u3002\n\u904A\u6232\u56DE\u5408\u4E0D\u6703\u53D7\u5230\u786C\u9AD4\u3001\u983B\u5BEC\u3001\u7DB2\u8DEF\u932F\u8AA4\u6216\u985E\u4F3C\u4E0D\u53EF\u9810\u898B\u7684\u5916\u90E8\u932F\u8AA4\u7684\u5F71\u97FF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 69304683977576452
    m_Localized: "\u4E00\u822C\u689D\u6B3E\u548C\u689D\u4EF6"
    m_Metadata:
      m_Items: []
  - m_Id: 69304683977576453
    m_Localized: "\u6240\u6709\u734E\u91D1\u4E58\u4EE5\u57FA\u790E\u6295\u6CE8\u3002\n\u6240\u6709\u91D1\u984D\u5747\u4EE5\u5BE6\u969B\u734E\u91D1\uFF08\u4EE5\u786C\u5E63\u8A08\u7B97\uFF09\u8868\u793A\u3002\n\u4F7F\u7528\u591A\u500B\u7B26\u865F\u7372\u52DD\u6642\uFF0C\u6240\u6709\u734E\u91D1\u5C07\u6DFB\u52A0\u5230\u7E3D\u734E\u91D1\u4E2D\u3002\n\u514D\u8CBB\u65CB\u8F49\u734E\u91D1\u5C07\u5728\u56DE\u5408\u7D50\u675F\u5F8C\u734E\u52F5\u7D66\u73A9\u5BB6\u3002\n\u6B77\u53F2\u8A18\u9304\u4E2D\u7684\u514D\u8CBB\u65CB\u8F49\u7E3D\u734E\u91D1\u5305\u542B\u8A72\u9031\u671F\u7684\u5168\u90E8\u734E\u91D1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 69304683977576454
    m_Localized: "\u4E0A\u65B9\u986F\u793A\u7684\u7B26\u865F\u8CE0\u4ED8\u53CD\u6620\u4E86\u76EE\u524D\u9078\u64C7\u7684\u6295\u6CE8\u7B49\u7D1A\u3002\u672C\u904A\u6232\u7684\u7406\u8AD6\u8CE0\u4ED8\u7387\u70BA
      {0}%\u3002 RTP \u662F\u900F\u904E\u6A21\u64EC 10,000,000,000 \u8F2A\u904A\u6232\u8A08\u7B97\u5F97\u51FA\u7684\u3002"
